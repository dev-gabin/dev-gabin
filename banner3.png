abel\":\"LegalZoom Prod Agent\"}]},\"is_device_based\":false,\"passed\":false},\"783652697\":{\"name\":\"783652697\",\"rule_id\":\"3Fk7LTbG3NkesGBOqbIJwe:100.00:4-3Fk7LRwDBvaK9h3SP3N6dc\",\"secondary_exposures\":[],\"version\":29,\"id_type\":\"stableID\",\"value\":{\"chatgpt.go\":{\"usd-mu\":600,\"sgd\":1100,\"usd-sc\":800,\"gbp\":700,\"ils\":2500,\"usd-re\":800,\"kzt\":339000,\"nzd\":1400,\"krw\":1300000,\"usd-bn\":600,\"usd-yt\":800,\"usd-mv\":600,\"sek\":8500,\"czk\":20000,\"dkk\":6400,\"myr\":2400,\"eur-es\":800,\"nok\":9900,\"jpy\":140000,\"aed\":3000,\"twd\":27000}},\"is_device_based\":true,\"passed\":true},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"user_prompt_key\":\"good_option\",\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\"},\"is_device_based\":false,\"passed\":false},\"1947723669\":{\"name\":\"1947723669\",\"rule_id\":\"targetingGate\",\"secondary_exposures\":[{\"gate\":\"1128318992\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":93,\"id_type\":\"stableID\",\"value\":{},\"is_device_based\":true,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"489084288\":{\"name\":\"489084288\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":32,\"id_type\":\"stableID\",\"value\":{\"options\":[\"google\",\"apple\",\"microsoft\",\"email\",\"phone_number\"]},\"is_device_based\":true,\"passed\":false},\"3774971069\":{\"name\":\"3774971069\",\"rule_id\":\"3wuW1nDxShKMpRhW6RD9w6-3wuW1lYvpZBi6rK0vJHwd4\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"tooltip\":\"Only includes tokens tracked after token-based pricing was enabled\"},\"is_device_based\":false,\"passed\":false},\"730493191\":{\"name\":\"730493191\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1584773534\",\"gateValue\":\"false\",\"ruleID\":\"0EJsCp3GoICPEDkX4u1bn\"}],\"version\":15,\"id_type\":\"userID\",\"value\":{\"tempDisabled\":false,\"loginStrategy\":\"existing_user\",\"name\":\"apple\",\"enabled\":true,\"kind\":\"social\"},\"is_device_based\":false,\"passed\":false},\"383746455\":{\"name\":\"383746455\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"disable_local_indexing\":false,\"disable_image_thumbnails\":false,\"disable_hover_previews\":false},\"is_device_based\":false,\"passed\":false},\"1171720776\":{\"name\":\"1171720776\",\"rule_id\":\"1UlyxmDKitlLIkNkL