ased\":false,\"passed\":false},\"208167308\":{\"name\":\"208167308\",\"rule_id\":\"6dhxyVTZ2QnuuwpxDwUiA8:100.00:24-6dhxyUeWAye0b6RC2oYFh6\",\"secondary_exposures\":[{\"gate\":\"2054053781\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3737660407\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3922602262\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1326334369\",\"gateValue\":\"true\",\"ruleID\":\"6XNtx5BnDu95sYciBN1U9z:100.00:9\"},{\"gate\":\"957497898\",\"gateValue\":\"false\",\"ruleID\":\"Bg20Kw8ydPcademg0qKQq:5.00:1\"}],\"version\":405,\"id_type\":\"userID\",\"value\":{\"exact_schedule_proactive_start_offset_seconds\":10,\"fiber_sync_suggestable_connectors_to_workspace\":false,\"automations_create_plan_tool_additional_guidance\":\"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.\",\"model_lane_override\":\"auto\",\"fiber_tool_call_elicitation_mode\":\"elicit_on_writes\",\"general_agent_invoked_system_hints\":[],\"additional_developer_message_prompt\":\"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \\n\\nExamples for when to output `::SKIP_COMPLETION::`:\\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\",\"max_turns_per_conversation\":175,\"bypass_chat_model_output\":true,\"enable_file_export\":true,\"gaas_extra_features\":{\"fast_mode\":true,\"multi_agent\":true},\"active_task_limit_message_template\":\"You've reached your limit of {active_limit} active tasks. To schedule more tasks, consider pausing some tasks or upgrading your plan.\",\"automations_list_limit\":100,\"enable_browser_tool\":true,\"fiber_generic_chatgpt_builtin_tool_references\":[{\"tool_type\":\"ToolRef\",\"tool_id\":\"automations\"},{\"tool_type\":\"ToolRef\",\"tool_id\":\"image_gen\"}],\"condition_watch_jitter_radius_seconds\":600,\"max_messages_per_conversation\":1000,\"max_active_automations\":5,\"webhook_trigger_user_prompt_template\":\"{automation_prompt}\\n\\nThis run was triggered by a webhook event. Use the event below as the new information to evaluate for this run.\\nWebhook family: {family}\\nWebhook event:\\n{normalized_event_json}\",\"skip_completion_text\":\"::SKIP_COMPLETION::\",\"personalized_task_card_read_timeout_seconds\":0.225,\"break_plugin_service_brte_history_chain\":true,\"slack_webhook_bot_membership_message_template\":\"I couldn't create an immediate Slack monitor because @ChatGPT isn't in {channel}. I can still set up an hourly monitor right now, or you can install or reconnect the [ChatGPT Slack app](https://chatgpt.com/slack-ai-app-install), add @ChatGPT to the channel, and try again for immediate notifications. Which would you like?\",\"fiber_gaas_model\":\"gpt-5.4-2s-codex-free-1p-codexswic-ev3\",\"max_iterations_per_hour\":1,\"automations_list_tool_additional_guidance\":\"The UI will already render the user's active automations from this list result. The automations will be rendered below your response Do NOT restate active automations in prose unless adding information not already visible to the user. Do not tell the user about any automations with enabled = false. They are considered deleted. You do not need to mention the UI either. Simply summarize in 1 sentence or less what automations exist.\\n\\nDo not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.\",\"private_peek_enabled\":true,\"exact_schedule_jitter_radius_